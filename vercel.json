{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "ignoreCommand": "sh scripts/vercel-ignore-build.sh",
  "crons": [
    {
      "path": "/api/v1/internal/email/dispatch",
      "schedule": "0 6 * * *"
    }
  ]
}
