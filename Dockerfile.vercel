FROM node:22-alpine AS verify
WORKDIR /src
RUN apk add --no-cache bash git
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY . .
RUN npm run verify:vercel

FROM node:22-alpine

WORKDIR /app
COPY --from=verify /src/package.json /tmp/pgi-verify-ok.json
ENV NODE_ENV=production

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
  && npm cache clean --force \
  && rm -rf /root/.npm

COPY --chown=node:node index.html client.html paiement-cb-result.html sitemap.xml manifest.webmanifest service-worker.js robots.txt llms.txt llms-full.txt fa0a7deb5d60bdf1260c8174ad8c71db.txt .nojekyll ./
COPY --chown=node:node site ./site
COPY --chown=node:node assets ./assets
COPY --chown=node:node backend ./backend
COPY --chown=node:node database ./database
COPY --chown=node:node scripts/build-static.mjs scripts/start-vercel.sh ./scripts/

RUN chown node:node /app && chmod 700 /app/scripts/start-vercel.sh
USER node

ENV PGI_BACKEND_MODE=production
ENV PGI_AUTH_MODE=session
ENV PGI_PROCESS_ROLE=api
ENV PGI_BACKEND_HOST=0.0.0.0
ENV PGI_API_BASE_URL=/api/v1
ENV PGI_STATIC_DIR=/app/dist
ENV PGI_DATABASE_SSL=require
ENV PGI_TRUST_PROXY=true
ENV PGI_PROTECT_MACHINE_ENDPOINTS=true

EXPOSE 8080

CMD ["sh","scripts/start-vercel.sh"]
